// a table of n points over 0..1, linearly interpolated
curve(w, n, x) = (1 - f) * rdtable(w, i) + f * rdtable(w, i + 1)
with {
    y = max(0, min(1, x)) * (n - 1);
    i = int(min(y, n - 2));
    f = y - i;
};
